<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://kit.fontawesome.com/a88acdeb6d.js" crossorigin="anonymous"></script>
    <title>@ViewBag.Title - My ASP.NET Application</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
    <script src="@Url.Content("~/Scripts/ScriptsPlaceHolder.js")"></script>
</head>
<body>
    <div class="container-top">
    </div>
    @Html.Partial("_NavBar")
    <div class="container body-content">
        @RenderBody()
    </div>
    <footer>
        <div class="footer-content">
            <div class="footer-container">
                <div class="footer">
                    <div class="footer-logo">
                        <img src="/UserFiles/logo.png" alt="logo" width="250" height="250" />
                    </div>
                    <div class="footer-heading footer-2">
                        <h3>Skilldemy</h3>
                        <a href="#">O nas</a>
                        <a href="#">Aktualności</a>
                        <a href="#">Oferta</a>
                        <a href="#">Kariera</a>
                    </div>
                    <div class="footer-heading footer-3">
                        <h3>Pomoc</h3>
                        <a href="#">O kursach</a>
                        <a href="#">Opinie klientów</a>
                        <a href="#">Kontakt</a>
                        <a href="#"></a>
                    </div>
                    <div class="footer-heading footer-4">
                        <h3>Dane kontaktowe</h3>
                        Skilldemy<br>
                        ul Powstańców Wielkopolskich 5<br>
                        61-895 Poznań<br>
                        NIP: 7781423778<br>
                        Telefon: 61 655 33 33
                    </div>
                    <div class="footer-heading footer-5">
                        <h3>Social Media</h3>
                        <ul class="socials">
                            <li><a href="#"><i class="fa-brands fa-facebook"></i></a></li>
                            <li><a href="#"><i class="fa fa-twitter"></i></a></li>
                            <li><a href="#"><i class="fa fa-google-plus"></i></a></li>
                            <li><a href="#"><i class="fa-brands fa-youtube"></i></a></li>
                            <li><a href="#"><i class="fa fa-linkedin-square"></i></a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
        <div class="footer-bottom">
            <p>&copy; @DateTime.Now.Year Skilldemy | All Rights Reserved.</p>
        </div>
    </footer>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>
