<div class="navbar navbar-inverse navbar-fixed-top">
    <div class="container">
        <div class="navbar-header">
            <button type="button" class="navbar-toggle" data-toggle="collapse" data-target=".navbar-collapse">
                <span class="icon-bar"></span>
                <span class="icon-bar"></span>
                <span class="icon-bar"></span>
            </button>
            @Html.ActionLink("Skilldemy", "Index", "Home", new { area = "" }, new { @class = "navbar-brand" })
        </div>
        <div class="navbar-collapse collapse">
            <ul class="nav navbar-nav">
                <li>@Html.ActionLink("Gastronomia", "SearchByText", "Home", new { searchPhrase = "Gastronomia"}, "")</li>
                <li>@Html.ActionLink("Programowanie", "SearchByText", "Home", new { searchPhrase = "Programowanie" }, "")</li>
                <li>@Html.ActionLink("Grafika komputerowa", "SearchByText", "Home", new { searchPhrase = "Grafika komputerowa" }, "")</li>
                <li>@Html.ActionLink("Języki obce", "SearchByText", "Home", new { searchPhrase = "Języki obce" }, "")</li>
                <li>@Html.ActionLink("Biznes", "SearchByText", "Home", new { searchPhrase = "Biznes" }, "")</li>
                <li>@Html.ActionLink("Finanse", "SearchByText", "Home", new { searchPhrase = "Finanse" }, "")</li>
            </ul>
            <input id="SearchByText" class="wystyluj-mnie-proszę" value="Wyszukaj" type="text" 
                   onfocus="if(this.value == 'Wyszukaj') {this.value=''}" onblur="if(this.value == ''){this.value ='Wyszukaj'}">
            <a onclick="changeHref();">
                <img src="~/UserFiles/magnifier.png" id="SearchBar_Magnifier" style="width:10px"/>
            </a>
            @Html.Partial("_LoginPartial")
        </div>
    </div>
</div>
<script type="text/javascript">
    function changeHref() {
        let url = '@Url.Action("SearchByText", "Home")';
        let txtVal = $('#SearchByText').val();
        if (txtVal === "Wyszukaj")
            txtVal = "";
        window.location.href = url + "?searchPhrase=" + txtVal;
    }
</script>