<script type="text/javascript">
    function changeHref() {
        let url = '@Url.Action("SearchByText", "Home")';
        let txtVal = $('#SearchByText').val();
        if (txtVal === "Wyszukaj")
            txtVal = "";
        window.location.href = url + "?searchPhrase=" + txtVal;
    }
</script>
<div class="navbar navbar-inverse navbar-fixed-top">
    <div class="navbar-header">
        @Html.ActionLink("Skilldemy ", "Index", "Home", new { area = "" }, new { @class = "navbar-brand" })
    </div>
    <div class="navbar-collapse collapse">
        <div class="nav navbar-nav">
            <div class="navbar-menu">
                <div class="dropdown">
                    <button class="dropbtn" onclick="myFunction()">
                        <b>Kategorie</b>
                        <i class="fa fa-caret-down"></i>
                    </button>
                    <div class="dropdown-content" id="myDropdown">
                        @Html.ActionLink("Gastronomia", "SearchByText", "Home", new { searchPhrase = "Gastronomia" }, "")
                        @Html.ActionLink("Programowanie", "SearchByText", "Home", new { searchPhrase = "Programowanie" }, "")
                        @Html.ActionLink("Grafika komputerowa", "SearchByText", "Home", new { searchPhrase = "Grafika komputerowa" }, "")
                        @Html.ActionLink("Języki obce", "SearchByText", "Home", new { searchPhrase = "Języki obce" }, "")
                        @Html.ActionLink("Biznes", "SearchByText", "Home", new { searchPhrase = "Biznes" }, "")
                        @Html.ActionLink("Finanse", "SearchByText", "Home", new { searchPhrase = "Finanse" }, "")
                    </div>
                </div>
            </div>
        </div>

        <input id="SearchByText" class="navbar-search" value="Wyszukaj" type="text"
                onfocus="if(this.value == 'Wyszukaj') {this.value=''}" onblur="if(this.value == ''){this.value ='Wyszukaj'}">
        <a onclick="changeHref();"><img src="~/UserFiles/magnifier.png" id="SearchBar_Magnifier" style="width: 20px" /></a>
        @Html.Partial("_LoginPartial")
    </div>
</div>