<div class="navbar navbar-inverse navbar-fixed-top">
    <div class="container">
        <div class="navbar-header">
            @Html.ActionLink("Skilldemy ", "Index", "Home", new { area = "" }, new { @class = "navbar-brand" })
        </div>
        <div class="navbar-collapse collapse">
            <div class="nav navbar-nav">
                <div class="navbar">
                    <div class="dropdown">
                        <button class="dropbtn">
                            Kategorie
                            <i class="fa fa-caret-down"></i>
                        </button>
                        <div class="dropdown-content">
                            <a href="#">@Html.ActionLink("Gastronomia", "SearchByText", "Home", new { searchPhrase = "Gastronomia" }, "")</a>
                            <a href="#">@Html.ActionLink("Programowanie", "SearchByText", "Home", new { searchPhrase = "Programowanie" }, "")</a>
                            <a href="#">@Html.ActionLink("Grafika komputerowa", "SearchByText", "Home", new { searchPhrase = "Grafika komputerowa" }, "")</a>
                            <a href="#">@Html.ActionLink("Języki obce", "SearchByText", "Home", new { searchPhrase = "Języki obce" }, "")</a>
                            <a href="#">@Html.ActionLink("Biznes", "SearchByText", "Home", new { searchPhrase = "Biznes" }, "")</a>
                            <a href="#">@Html.ActionLink("Finanse", "SearchByText", "Home", new { searchPhrase = "Finanse" }, "")</a>
                        </div>
                    </div>
                </div>
            </div>

            <input id="SearchByText" class="navbar-search" value="Wyszukaj" type="text"
                   onfocus="if(this.value == 'Wyszukaj') {this.value=''}" onblur="if(this.value == ''){this.value ='Wyszukaj'}">
            <a onclick="changeHref();"><img src="~/UserFiles/magnifier.png" id="SearchBar_Magnifier" style="width: 20px" /></a>
            @Html.Partial("_LoginPartial")
        </div>
    </div>
</div>
<script type="text/javascript">
    function changeHref() {
        let url = '@Url.Action("SearchByText", "Home")';
        let txtVal = $('#SearchByText').val();
        if (txtVal === "Wyszukaj")
            txtVal = "";
        window.location.href = url + "?searchPhrase=" + txtVal;
    }
</script>