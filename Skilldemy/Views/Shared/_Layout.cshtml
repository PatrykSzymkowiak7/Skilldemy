<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://kit.fontawesome.com/a88acdeb6d.js" crossorigin="anonymous"></script>
    <title>@ViewBag.Title</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
    <script src="@Url.Content("~/Scripts/ScriptsPlaceHolder.js")"></script>
</head>
<body>
    <div class="navbar">
        @Html.Partial("_NavBar")
    </div>
    <div class="container-body-content">
        @RenderBody()
    </div>
    <div class="container-top">
        <div class="container-top-baner">
            <span class="title1">Skilldemy</span>
            <span class="title2">Kursy on-line</span>
        </div>
    </div>
    <div class="container-body-top">
        <div class="inf-kaf1">
            <div class="opinie">
                <div class="course-card">
                    <div class="course-info">
                        <h3 class="course-title">Nie przegap szansy na rozwój</h3>
                        <p class="course-description">Sprawdź aktualną ofertę kursów, jakie dla Ciebie przygotowaliśmy. Wybierz szkolenie i zacznij zdobywać nowe umiejętności już teraz.</p>
                        <a href="@Url.Action("CourseList", "Home")">
                            <button class="course-button">Zobacz ofertę</button>
                        </a>
                    </div>
                </div>
            </div>
        </div>
        <div class="inf-kaf2" style="background-color: #c31a1a; color:#fff;">
            <div class="opinie">
                <div class="course-card">
                    <div class="course-info">
                        <h3 class="course-title">Dołącz do grona twórców</h3>
                        <p class="course-description"></p>
                        <a href="@Url.Action("Register", "Account")">
                            <button class="course-button">Załóż konto</button>
                        </a>
                    </div>
                </div>
            </div>
        </div>
        <div class="inf-kaf3">
            <div class="opinie">
                <div class="course-card">
                    <div class="course-info">
                    </div>
                </div>
            </div>
        </div>
        <div class="inf-kaf2">
            <div class="opinie">
                <div class="course-card">
                    <div class="course-info" style="text-align: center;">
                        <div class="imgBx">
                            <img src="/UserFiles/info4.png" style="width: 50%; height: 40%; margin-bottom: 20px;">
                        </div>
                        <p class="course-description">wykup kurs i zyskaj trzykrotny dostęp</p>
                    </div>
                </div>
            </div>
        </div>
        <div class="inf-kaf2">
            <div class="opinie">
                <div class="course-card">
                    <div class="course-info">
                        <h3 class="course-title">Zdobywaj wiedzę</h3>
                        <p class="course-description">rozpocznij naukę i poprawiaj swoje umiejętności razem z naszym zespołem</p>
                        <div class="imgBx">
                            <img src="/UserFiles/info5.png" style="width: 98%; height: 100%; margin-bottom: 15px;">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="photo-body">
        <div class="photo-body-container">
            <div class="box">
                <div class="imgBx">
                    <img src="/UserFiles/photos/book1.png">
                </div>
                <div class="content">
                    <div>
                        <h2>Koncentracja</h2>
                        <p>
                            Wybierz spokojne miejsce do nauki. Środowisko w którym się uczysz nie powinno Cie rozpraszać.
                        </p>
                    </div>
                </div>
            </div>
            <div class="box">
                <div class="imgBx">
                    <img src="/UserFiles/photos/book2.png">
                </div>
                <div class="content">
                    <div>
                        <h2>Inżynieria</h2>
                        <p>
                            Pomagamy zdobywać praktyczną wiedzę, która przybliży Cię do celu.
                        </p>
                    </div>
                </div>
            </div>
            <div class="box">
                <div class="imgBx">
                    <img src="/UserFiles/photos/book3.png">
                </div>
                <div class="content">
                    <div>
                        <h2>Logika</h2>
                        <p>
                            Nasze kursy są utworzone w taki sposób, aby z łatwością były przyswajalne przez naszych klientów.
                        </p>
                    </div>
                </div>
            </div>
            <div class="box">
                <div class="imgBx">
                    <img src="/UserFiles/photos/book4.png">
                </div>
                <div class="content">
                    <div>
                        <h2>Lingwistyka</h2>
                        <p>
                            Działamy ściśle z tytułowanymi expertami w dziedzinie języków.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="form-block">
        <div class="container-contact">

            <p>Kontakt</p>

            <div class="login">
                <input type="text" class="input-login" placeholder="Imię" />
                <input type="text" class="input-mail" placeholder="E-mail" />
            </div>

            <div class="topic">
                <input type="text" class="input-topic" placeholder="Temat" />
            </div>

            <div class="msng">
                <textarea class="area" placeholder="Opis"></textarea>
            </div>

            <div class="course-button-contact" type="button">Wyślij wiadomość</div>
        </div>
        <div class="container-contact-photo">
            <img src="/UserFiles/photos/contact.png" class="contact1">
        </div>
    </div>
    <div class="container-body-bottom">
        <div class="container-body-title">
            Opinie o nas
        </div>
        <div class="opinion-1">
            <div class="opinion">
                <div class="customer-review">
                    <img src="/UserFiles/customer-avatar1.jpg" alt="Customer Avatar" class="avatar">
                    <div class="review-content">
                        <h3 class="customer-name">Ania Kowal</h3>
                        <p class="customer-review-text">
                            Polecam! Świetnie przygotowane kursy. Za niewielkie pieniądze zdobywam wiedzę, która pozwala mi więcej zarabiać, lepiej pracować. Treści kursów są bardzo merytoryczne i wartościowe, do tego niska cena i dostęp z każdego miejsca na ziemi. :)
                        </p>
                    </div>
                </div>
            </div>
        </div>
        <div class="opinion-1">
            <div class="opinion">
                <div class="customer-review">
                    <img src="/UserFiles/customer-avatar2.jpg" alt="Customer Avatar" class="avatar">
                    <div class="review-content">
                        <h3 class="customer-name">Ewa Lisek</h3>
                        <p class="customer-review-text">
                            Kursy bardzo dobrze tłumaczą zagadnienia, co pozwala z dużą łatwością przyswoić nową wiedzę. Jestem bardzo zadowolona, skorzystam jeszcze nie raz. Dziękuję i gorąco polecam.
                        </p>
                    </div>
                </div>
            </div>
        </div>
        <div class="opinion-1">
            <div class="opinion">
                <div class="customer-review">
                    <img src="/UserFiles/customer-avatar3.jpg" alt="Customer Avatar" class="avatar">
                    <div class="review-content">
                        <h3 class="customer-name">Andrzej Dmowski</h3>
                        <p class="customer-review-text">
                            Jestem zachwycony tą platformą, taki ogrom wiedzy w jednym miejscu. Kursy bardzo dobrze przygotowane i w przestępnej cenie. Super!
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <div class="opinion-1">
            <div class="opinion">
                <div class="customer-review">
                    <img src="/UserFiles/customer-avatar4.jpg" alt="Customer Avatar" class="avatar">
                    <div class="review-content">
                        <h3 class="customer-name">Aneta Jańczyk</h3>
                        <p class="customer-review-text">
                            Platforma daje możliwość zakupu bardzo satrannie przygotowanych kursów z różnych dziedzin, które pomagają nie tylko w rozwijaniu własnego hobby, jak programowanie, ale są również pomocne w zdobywaniu i doskonaleniu umiejętności w gotowaniu. Polecam!
                        </p>
                    </div>
                </div>

            </div>
        </div>
        <div class="opinion-1">
            <div class="opinion">
                <div class="customer-review">
                    <img src="/UserFiles/customer-avatar5.jpg" alt="Customer Avatar" class="avatar">
                    <div class="review-content">
                        <h3 class="customer-name">Dawid Szumalik</h3>
                        <p class="customer-review-text">
                            Równowaga pomiędzy teorią a praktyką została osiągnięta. Konkretne zagadnienia zilustrowane przykładami, dzięki temu znacznie więcej zapadło w pamięci. Kurs bardzo ciekawie przeprowadzony. Świetna sprawa, polecam!
                        </p>
                    </div>
                </div>
            </div>
        </div>
        <div class="opinion-1">
            <div class="opinion">
                <div class="customer-review">
                    <img src="/UserFiles/customer-avatar6.jpg" alt="Customer Avatar" class="avatar">
                    <div class="review-content">
                        <h3 class="customer-name">Piotr Nowak</h3>
                        <p class="customer-review-text">
                            Szkolenie przedstawione w bardzo przyjemnej formie, przepełnione ciekawą i wysokiej jakości treścią. Na pewno będę tutaj wracać i korzystać z kolejnych kursów.
                        </p>
                    </div>
                </div>
            </div>
        </div>

    </div>
    <div class="container-map">
        <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2434.146994739298!2d16.920377615803137!3d52.404012079792466!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x47045b309dae6ae9%3A0x835a1af76866d48b!2sWy%C5%BCsza%20Szko%C5%82a%20Bankowa%20w%20Poznaniu!5e0!3m2!1sen!2spl!4v1662576977248!5m2!1sen!2spl" class="loc-map" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
    </div>
    <footer>
        <div class="footer-content">
            <div class="footer-container">
                <div class="footer">
                    <div class="footer-logo">
                        <img src="/UserFiles/logo.png" alt="logo" width="250" height="250" />
                    </div>
                    <div class="footer-heading footer-4">
                        <h3>Dane kontaktowe</h3>
                        Skilldemy<br>
                        ul Powstańców Wielkopolskich 5<br>
                        61-895 Poznań<br>
                        NIP: 7781423778<br>
                        Telefon: 61 655 33 33
                    </div>
                    <div class="footer-heading footer-5">
                        <h3>Media Społecznościowe</h3>
                        <div class="socials">
                            <a href="#"><i class="fa-brands fa-facebook"></i></a>
                            <a href="#"><i class="fa fa-twitter"></i></a>
                            <a href="#"><i class="fa fa-google-plus"></i></a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="footer-bottom">
            <p>&copy; @DateTime.Now.Year Skilldemy | All Rights Reserved.</p>
        </div>
    </footer>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>
