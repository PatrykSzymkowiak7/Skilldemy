@model Skilldemy.Models.Payment

@{
    ViewBag.Title = "Skilldemy";
    Layout = "~/Views/Shared/_LayoutCourseListView.cshtml";
}

<div class="container my-5 z-depth-1">
    <!--Section: Content-->
    <section class="dark-grey-text">

        <div class="row pr-lg-5">
            <div class="col-md-5 d-flex align-items-center" style="position:relative; padding-top:70px; padding-bottom:70px; text-align:center; width:700px; border:7px; border-style:solid; border-radius:25px; margin-top:150px;">
                <div>
                    <img src="/UserFiles/success_clipart.png" class="img-fluid" alt="smaple image" style="height: 150px; max-width: 100%;">
                    <br />
                    <h3 class="font-weight-bold mb-4">Płatność zakończona sukcesem!</h3>

                    <p>
                        <h4>Na twój adres mailowy <b>@Model.EmailAddress</b> została przesłana wiadomość z linkiem dostępowym uprawniającym Cię do trzykrotnego skorzystania z kursu!</h4>
                    </p>
                    <br />
                    <a href="@Url.Action("CourseList", "Home")">
                        <button class="btn btn-success" style="font-size:16px;">Wróć na listę kursów</button>
                    </a>
                    <br />
                </div>
            </div>
        </div>

    </section>
    <!--Section: Content-->
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}