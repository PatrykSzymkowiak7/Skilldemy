@model Skilldemy.Models.PaymentViewModel

@{
    Layout = "~/Views/Shared/_LayoutCourseListView.cshtml";
    ViewBag.Title = "Przygotuj płatność";
}

@using (Html.BeginForm("CreatePayment", "Payment", FormMethod.Post, new { @class = "form-horizontal", role = "form", encType = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary("", new { @class = "text-danger" })
    <br />
    <div class="form-group">
        @Html.AntiForgeryToken()
        <hr />
        <div class="form-group">
            @Html.LabelFor(m => m.FirstName, new { @class = "col-md-2 control-label" })
            <div class="col-md-10">
                @Html.TextBoxFor(m => m.FirstName, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.FirstName)
            </div>
        </div>
        <div class="form-group">
            @Html.LabelFor(m => m.LastName, new { @class = "col-md-2 control-label" })
            <div class="col-md-10">
                @Html.TextBoxFor(m => m.LastName, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.LastName)
            </div>
        </div>
        <div class="form-group">
            @Html.LabelFor(m => m.EmailAddress, new { @class = "col-md-2 control-label" })
            <div class="col-md-10">
                @Html.TextBoxFor(m => m.EmailAddress, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.EmailAddress)
            </div>
        </div>
        @Html.HiddenFor(m => m.Crc)
        @Html.HiddenFor(m => m.Description)
        @Html.HiddenFor(m => m.Amount)
        <div class="col-md-offset-2 col-md-10">
            <input type="submit" id="submitPayment" class="btn btn-success" value="Zapłać" style="width:150px;margin-left:50px;" />
        </div>
    </div>
}
<div class="footerHack" style="margin-bottom:450px;">&nbsp</div>
@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
