@model Skilldemy.Models.SectionViewModel
@{
    ViewBag.Title = "Zarządzaj sekcjami";
}

<h2>@ViewBag.Title</h2>

@using (Html.BeginForm("AddSection", "Course", FormMethod.Post, new { @class = "form-horizontal", role = "form", encType = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    <hr />
    @Html.ValidationSummary("", new { @class = "text-danger" })
    <br />
    <div class="form-group">
        @Html.AntiForgeryToken()
        <hr />
        @Html.ValidationSummary("", new { @class = "text-danger" })
        <div class="form-group">
            @Html.LabelFor(m => m.SectionTitle, new { @class = "col-md-2 control-label" })
            <div class="col-md-10">
                @Html.TextBoxFor(m => m.SectionTitle, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.SectionTitle)
            </div>
        </div>
        <div class="form-group">
            @Html.LabelFor(m => m.SectionDescription, new { @class = "col-md-2 control-label" })
            <div class="col-md-10">
                @Html.TextBoxFor(m => m.SectionDescription, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.SectionDescription)
            </div>
        </div>
        <div class="form-group">
            @Html.LabelFor(m => m.VideoFile, new { @class = "col-md-2 control-label" })
            <div class="col-md-10">
                @Html.TextBoxFor(m => m.VideoFile, new { type = "file" })
                @Html.ValidationMessageFor(m => m.VideoFile)
            </div>
        </div>
        @Html.HiddenFor(m => m.CourseId)
        <div class="col-md-offset-2 col-md-10">
            @Html.ActionLink("Wróć", "Index", "Manage")
            <input type="submit" class="btn btn-default" value="Dodaj sekcję" />
        </div>
    </div>
}

<div id='myModal' class='modal'>
    <div class="modal-dialog">
        <div class="modal-content">
            <div id='myModalContent'></div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
    var TeamDetailPostBackURL = '/Home/Details';
    $(function () {
        $(".anchorDetail").click(function () {
            var $buttonClicked = $(this);
            var id = $buttonClicked.attr('data-id');
            var options = { "backdrop": "static", keyboard: true };
            $.ajax({
                type: "GET",
                url: TeamDetailPostBackURL,
                contentType: "application/json; charset=utf-8",
                data: { "Id": id },
                datatype: "json",
                success: function (data) {
                    $('#myModalContent').html(data);
                    $('#myModal').modal(options);
                    $('#myModal').modal('show');

                },
                error: function () {
                    alert("Dynamic content load failed.");
                }
            });
        });
        $("#closbtn").click(function () {
            $('#myModal').modal('hide');
        });
    });
    </script>
}
