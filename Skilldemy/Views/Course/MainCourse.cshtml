            <label for="star5" title="Bardzo dobry kurs" data-action="@Url.Action("ReviewCourse", "Course", new { id = Model.Course.Id, score = 5,  uuid = Model.currentUuid,  courseEntries = Model.CourseEntries})">5 stars</label>
