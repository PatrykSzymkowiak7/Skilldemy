@model Skilldemy.Models.SectionViewModel
@{
    ViewBag.Title = "Zarządzaj sekcjami";
}

<h2>@ViewBag.Title</h2>
<div id="whole-form" style="backdrop-filter: blur(5px);">
    @using (Html.BeginForm("AddSection", "Course", FormMethod.Post, new { @class = "form-horizontal", role = "form", encType = "multipart/form-data" }))
    {
        @Html.AntiForgeryToken()
        <hr />
        @Html.ValidationSummary("", new { @class = "text-danger" })
        <br />
        <div class="form-group">
            @Html.AntiForgeryToken()
            <hr />
            @Html.ValidationSummary("", new { @class = "text-danger" })
            <div class="form-group">
                @Html.LabelFor(m => m.SectionTitle, new { @class = "col-md-2 control-label" })
                <div class="col-md-10">
                    @Html.TextBoxFor(m => m.SectionTitle, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.SectionTitle)
                </div>
            </div>
            <div class="form-group">
                @Html.LabelFor(m => m.SectionDescription, new { @class = "col-md-2 control-label" })
                <div class="col-md-10">
                    @Html.TextBoxFor(m => m.SectionDescription, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.SectionDescription)
                </div>
            </div>
            <div class="form-group">
                @Html.LabelFor(m => m.VideoFile, new { @class = "col-md-2 control-label" })
                <div class="col-md-10">
                    @Html.TextBoxFor(m => m.VideoFile, new { type = "file" })
                    @Html.ValidationMessageFor(m => m.VideoFile)
                </div>
            </div>
            @Html.HiddenFor(m => m.CourseId)
            <div class="col-md-offset-2 col-md-10">
            <a href="@Url.Action("Index", "Manage")">
                <button class="btn btn-default">Wróć</button>
            </a>
            <input type="submit" id="sectionSubmit" class="btn btn-default" value="Dodaj sekcję" />
        </div>
        </div>
    }
</div>

<div class="modal show" style="display: block !important; filter: blur(0px) !important;" id="MyPopUp" role="dialog">
    <div class="modal-dialog" style="display: block !important; filter: blur(0px) !important; ">
        <div class="modal-content" style="display: block !important; filter: blur(0px) !important;">
            <div class="modal-body" style="display: block !important; filter: blur(0px) !important; ">
                <div class="modal-body-top">
                    <h2> Sekcja utworzona! </h2>
                </div>
                <div class="tick">

                </div>
                <div class="float-container">
                    <div class="btn-popup">
                        <a href="@Url.Action("AddAnotherSection", "Course", new { id = Model.CourseId })">
                            <button class="button-style">Następna sekcja</button>
                        </a>&nbsp&nbsp
                    </div>
                    <div class="btn-popup">
                        <a href="@Url.Action("Index", "Manage")">
                            <button class="button-style">Zakończ dodawanie</button>
                        </a>
                    </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts{
}
<div class="modal-backdrop fade in"></div>