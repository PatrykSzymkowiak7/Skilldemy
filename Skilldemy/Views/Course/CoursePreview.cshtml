@model Skilldemy.Models.CoursePreviewViewModel

@{
    ViewBag.Title = "Home Page";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@{
    var previewVideo = Model.Videos.FirstOrDefault(m => m.IsPreviewVideo == true);
    var messySectionsList = Model.Videos.Where(m => m.IsPreviewVideo != true);
    var sortedSectionList = messySectionsList.OrderBy(m => m.UploadedDate);
    
}

<div class="course-availables">
    <h2>@Model.Course.Title</h2>
</div>

<div class="main-course-wrapper">
    <div class="main-course-left">
        <video controls autoplay oncontextmenu="return false;" controlsList="nodownload">
            <source src='@Url.Action("ShowVideo", "Course", new { id = previewVideo.Id })' type="video/mp4" style="width:300px;height:300px" />
        </video>
    </div>
    <div class="main-course-right" onclick="switchVisible();">
        @foreach (var fetchedSection in sortedSectionList)
        {
        <div id="@fetchedSection.Id main-course-section-title">
            @fetchedSection.SectionTitle
        </div>
        <div id="@fetchedSection.Id main-course-section-description">
            @fetchedSection.SectionDescription
        </div>
        }

    </div>
</div>
@Html.ActionLink("Zakup kurs", "Index", "Manage")
@section Scripts
{
    <script>
    </script>
}
