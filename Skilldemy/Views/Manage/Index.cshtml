@model Skilldemy.Models.IndexViewModel
@{
    Layout = "~/Views/Shared/_LayoutCourseListView.cshtml";
    ViewBag.Title = "Skilldemy";
}
<p class="text-success">@ViewBag.StatusMessage</p>
<div>
    <div class="container my-5 z-depth-1">
        <!--Section: Content-->
        <section class="dark-grey-text">

            <div class="row pr-lg-5">
                <div class="col-md-7 mb-4">
                    <div class="view" style="max-width: 100%; flex-basis: 40%;">
                        <img src="https://mdbootstrap.com/img/illustrations/graphics(4).png" class="img-fluid" alt="smaple image" style="height: 500px; max-width: 100%; position: relative; flex-basis: 40%">
                    </div>

                </div>
                <div class="col-md-5 d-flex align-items-center" style="position:relative; padding-top:140px; text-align:center;">
                    <div>

                        <h3 class="font-weight-bold mb-4">Utwórz kurs</h3>

                        <p class="text-muted" style="font-size:17px;">
                            Stwórz swój własny kurs online! Skorzystaj z intuicyjnego narzędzia do tworzenia kursów które pozwala w łatwy i szybki sposób na stworzenie nowego kursu od podstaw. Wymagane jest jedynie przygotowanie własnych materiałów
                            wideo - filmu demo i filmu widocznego po zakupie kursu, jak i miniaturki która zaprezentuje twoją pracę!
                        <p/>

                        <a href="@Url.Action("CreateCourse", "Course")">
                            <button class="btn btn-success">Utwórz nowy</button>
                        </a>

                    </div>
                </div>
            </div>

        </section>
        <!--Section: Content-->
    </div>

    <div class="container my-5 py-5 z-depth-1">
        <!--Section: Content-->
        <section class="px-md-5 mx-md-5 text-center text-lg-left dark-grey-text">

            <!--Grid row-->
            <div class="row">

                <!--Grid column-->
                <div class="col-md-6 mb-4 mb-md-0" style="position:relative; padding-top:170px; text-align:center;">

                    <h3 class="font-weight-bold">Przeglądaj swoje kursy</h3>

                    <p class="text-muted" style="font-size:17px;">
                        Przejdź do listy kursów które stworzyłeś, aby zarządzać ich widocznością na głównej liście kursów, usunąć je na stałe z naszej bazy danych lub edytować ich zawartość zmieniając miniaturkę, tytuł, materiał<br /> wideo i nie tylko!
                    </p>
                    <a href="@Url.Action("MyCourses", "Course")">
                        <button class="btn btn-success">Przeglądaj kursy</button>
                    </a>

                </div>
                <!--Grid column-->
                <!--Grid column-->
                <div class="col-md-6 mb-4 mb-md-0">
                    <!--Image-->
                    <div class="view overlay z-depth-1-half">
                        <img src="/UserFiles/change_data.png" class="img-fluid" alt="smaple image" style="height: 500px; max-width: 100%; position: relative; flex-basis: 40%">
                    </div>
                </div>
                <!--Grid column-->
            </div>
            <!--Grid row-->
        </section>
        <!--Section: Content-->
    </div>

    <div class="container my-5 z-depth-1">
        <!--Section: Content-->
        <section class="dark-grey-text" style="margin-bottom:50px">

            <div class="row pr-lg-5">
                <div class="col-md-7 mb-4">
                    <div class="view" style="max-width: 100%; flex-basis: 40%;">
                        <img src="/UserFiles/password_manage.png" class="img-fluid" alt="smaple image" style="height: 500px; max-width: 100%; position: relative; flex-basis: 40%">
                    </div>

                </div>
                <div class="col-md-5 d-flex align-items-center" style="position:relative; padding-top:120px; text-align:center;">
                    <div>

                        <h3 class="font-weight-bold mb-4">Zmień moje dane</h3>

                        <p class="text-muted" style="font-size:17px;">
                            Zarządzaj swoim kontem edytując dane wprowadzone podczas rejestracji, takie jak - adres email i dane adresowe, lub zmień swoje aktualnie używane hasło na jakieś mocniejsze!
                        </p>

                        <a href="@Url.Action("EditAccount", "Manage")">
                            <button class="btn btn-success">Zmień dane</button>
                        </a>                       
                        <a href="@Url.Action("ChangePassword", "Manage")">
                            <button class="btn btn-success">Zmień hasło</button>
                        </a>

                    </div>
                </div>
            </div>

        </section>
        <!--Section: Content-->
    </div>
