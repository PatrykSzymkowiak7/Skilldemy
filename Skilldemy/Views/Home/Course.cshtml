@model Skilldemy.Models.Course

@{
    ViewBag.Title = "Home Page";
    Layout = "~/Views/Shared/_LayoutCourseListView.cshtml";
}

<div class="course-availables">
    <h2>@Model.Title</h2>
</div>

<div class="main-course-wrapper">
    <div class="main-course-left">
        <video controls="controls">
            <source src="~/Videos/gordon.mp4" type="video/mp4" style="width:300px;height:300px"/>
        </video>
    </div>
    <div class="main-course-right" onclick="switchVisible();">
        <div id="main-course-section">
            Sekcja 1
            <div class="main-course-subsection">Podsekcja 1</div>
            <div class="main-course-subsection">Podsekcja 2</div>
            <div class="main-course-subsection">Podsekcja 3</div>
        </div>
    </div>
</div>
@section Scripts
{
    <script>
        function switchVisible() {
            var sub = document.getElementsByClassName('main-course-subsection');

            Array.from(sub).forEach((x) => {
                if (x.style.display === "none") {
                    x.style.display = "block";
                } else {
                    x.style.display = "none";
                }
            })
        }
    </script>
}
